{
  "name": "anumitra",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web,worker \"tsx watch apps/api/src/index.ts\" \"vite --host 127.0.0.1\" \"tsx watch apps/worker/src/index.ts\"",
    "build": "node scripts/pdf-assets.mjs && tsc --noEmit && vite build",
    "predev": "node scripts/pdf-assets.mjs",
    "start": "tsx apps/api/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "db:generate": "prisma generate --schema packages/db/schema.prisma",
    "db:migrate": "node scripts/migrate.mjs",
    "db:harden": "node scripts/harden-runtime.mjs",
    "db:seed": "tsx packages/db/seed.ts",
    "demo:reset": "tsx scripts/new-demo-run.ts --new-run",
    "bootstrap": "node scripts/bootstrap.mjs",
    "test": "node scripts/verify.mjs --backend",
    "format:check": "prettier --check apps packages tests scripts vite.config.ts playwright.config.ts",
    "test:browser": "node scripts/verify.mjs --browser-only",
    "typecheck": "tsc --noEmit",
    "verify:isolated": "node scripts/verify.mjs",
    "verify:repair": "node scripts/verify.mjs --backend --repair-only",
    "doctor": "tsx scripts/doctor.ts",
    "storage:reconcile": "tsx scripts/reconcile-storage.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/space-grotesk": "5.2.10",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@tanstack/react-query": "5.90.2",
    "bcryptjs": "3.0.2",
    "connect-pg-simple": "10.0.0",
    "csv-parse": "7.0.3",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.18.2",
    "helmet": "8.1.0",
    "lucide-react": "0.548.0",
    "multer": "2.5.0",
    "nodemailer": "10.2.1",
    "pdfjs-dist": "5.4.296",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "pg-boss": "10.3.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.14",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.3",
    "@types/express-session": "1.18.2",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.10",
    "@types/nodemailer": "7.0.2",
    "@types/pdfkit": "0.17.3",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
