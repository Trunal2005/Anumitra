# Native bootstrap generates distinct local accounts on a fresh setup.
# Keep the migration-owner URL separately in ignored .local/migration.env.
DATABASE_URL=postgresql://anumitra_app:CHANGE_ME@127.0.0.1:55432/anumitra
WORKER_DATABASE_URL=postgresql://anumitra_worker:CHANGE_ME@127.0.0.1:55432/anumitra
SESSION_SECRET=GENERATE_RANDOM_64_HEX_CHARACTERS
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3000
DEMO_MODE=true
NODE_ENV=development
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
STORAGE_PATH=storage/private
INTEGRATION_MODE=LOCAL_ADAPTER
